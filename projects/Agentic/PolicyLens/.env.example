# Start in extractive mode: no key, no network calls, verbatim source passages.
# For generated answers + neural embeddings, set RAG_MODE=openai and your key.
RAG_MODE=extractive
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Change these before rebuilding the index. Sizes are actual cl100k_base tokens.
CHUNK_SIZE=500
CHUNK_OVERLAP=75
RETRIEVAL_CANDIDATES=16
RETRIEVAL_TOP_K=5
LATENCY_TARGET_SECONDS=10
FRESHNESS_DAYS=7

