{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!next-env.d.ts", "!**/.next", "!**/*.md", "!tests/fixtures"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useNamingConvention": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"] }
        },
        "noNonNullAssertion": "error",
        "noDefaultExport": "error",
        "noMagicNumbers": "error",
        "useImportType": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noImportCycles": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "performance": {
        "noBarrelFile": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["app/**/page.tsx", "app/**/layout.tsx", "app/**/not-found.tsx", "*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "lib/config.ts",
        "tests/unit/config.test.ts",
        "vitest.config.ts",
        "next.config.ts",
        "tests/unit/next-config.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  { "selector": { "kind": "objectLiteralProperty" }, "formats": ["camelCase", "CONSTANT_CASE"] }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["lib/chat/lane-examples.ts", "tests/unit/utils.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "_?(.+)",
                    "formats": ["camelCase", "PascalCase"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "lib/upstream/open-meteo.ts",
        "lib/weather/actor-items.ts",
        "tests/unit/weather/actor-items.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  { "selector": { "kind": "objectLiteralProperty" }, "formats": ["camelCase", "snake_case"] }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "lib/types.ts",
        "lib/weather/open-meteo-tools.ts",
        "lib/lanes/rest-no-auth.ts",
        "lib/lanes/mcp-no-auth.ts",
        "lib/lanes/rest-auth.ts",
        "lib/lanes/mcp-auth.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  { "selector": { "kind": "objectLiteralProperty" }, "formats": ["camelCase", "snake_case"] },
                  { "selector": { "kind": "typeProperty" }, "formats": ["camelCase", "snake_case"] }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["playwright.config.ts", "lib/sentry.ts", "tests/unit/sentry.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": { "level": "error", "options": { "strictCase": false } }
          }
        }
      }
    },
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    }
  ]
}
