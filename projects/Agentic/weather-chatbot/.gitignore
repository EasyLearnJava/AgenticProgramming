# The Python tools' caches. The repository's own .gitignore already leaves out .venv/, __pycache__/, .pytest_cache/,
# and every .env file except .env.example.
/.mypy_cache/
/.ruff_cache/

# The Vercel CLI's link to the project
/.vercel/

# Playwright's reports
/test-results/
/harness-output/
/playwright-report/

# Legacy local model downloads stay ignored; current park preparation uses only a bundled tokenizer.
/data/parks/model/
/data/parks/raw/
