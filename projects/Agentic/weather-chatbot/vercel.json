{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": {
      "excludeFiles": "{tests/**,tools/**,**/__pycache__/**,.mypy_cache/**,.ruff_cache/**,.pytest_cache/**}"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "content-security-policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        { "key": "x-content-type-options", "value": "nosniff" },
        { "key": "referrer-policy", "value": "strict-origin-when-cross-origin" },
        { "key": "x-frame-options", "value": "DENY" },
        { "key": "permissions-policy", "value": "camera=(), geolocation=(self), microphone=()" }
      ]
    }
  ]
}
