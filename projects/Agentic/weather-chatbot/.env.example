# Copy this file to .env.local, in this same folder, for settings on your computer: git never sees .env.local, and this
# example file goes into git, so it must never hold a real value. On Vercel, set the same names in the project's
# settings (Settings > Environment Variables) instead, then redeploy: a deployment keeps the settings it was built
# with. Vercel sets VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA and VERCEL_DEPLOYMENT_ID itself; the app reads those
# from the real environment only, so the copies `vercel env pull` writes here change nothing.

# Optional: how much to log: debug, info, warning or error. Left empty, it's info.
LOG_LEVEL=

# Step 3: the key for Gemini, from Google AI Studio. Without it, the chat says "The assistant isn't set up on this
# deployment yet." On Vercel, make it a Sensitive variable. Optional: which Gemini model answers; left empty, it's
# gemini-3.5-flash-lite.
GOOGLE_API_KEY=
GEMINI_MODEL=

# Optional: LangSmith's tracing, into LANGSMITH_PROJECT (else LangSmith's default). The app traces only when both
# LANGSMITH_HIDE_INPUTS and LANGSMITH_HIDE_OUTPUTS are true, and hides both itself: no question or answer reaches it.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# The workspace UUID that owns LANGSMITH_PROJECT, for a key that reaches more than one workspace; Activity's
# trace view reads the trace there. A value that isn't a UUID stops the app at start.
LANGSMITH_WORKSPACE_ID=
LANGSMITH_HIDE_INPUTS=
LANGSMITH_HIDE_OUTPUTS=

# Step 10: Apify's token, for the lanes with auth; without it, they're closed. On Vercel, make it a Sensitive variable.
APIFY_TOKEN=

# Step 12: Axiom's token, one that can only ingest into the dataset, and the dataset's name; without both, the lines
# stay in Vercel's logs. On Vercel, make the token a Sensitive variable. And Sentry's DSN; without it, Sentry is off.
AXIOM_TOKEN=
AXIOM_DATASET=
SENTRY_DSN=

# Step 14: a second Axiom token, an advanced one that can only query AXIOM_DATASET, for the Observability pages;
# without it, they say Axiom isn't connected. On Vercel, make it a Sensitive variable.
AXIOM_QUERY_TOKEN=

# Step 16: official park guidance. Enabled by default; false removes the two knowledge tools from chat.
# Install optional local inference with uv sync --group ml; the deployment dependency set excludes ML.
# auto uses keyword retrieval on Vercel, and local MiniLM only when dependencies and pinned weights are present.
# lexical always uses keywords; hybrid explicitly opts into an ML-capable host.
# Model cache defaults to data/parks/model. Revision must match the index; changing it requires rebuilding.
# Missing cached weights use keyword retrieval. No visitor conversation is kept in this index.
PARKS_ENABLED=

PARKS_RETRIEVAL_MODE=
PARKS_INDEX_PATH=
PARKS_MODEL_CACHE=
PARKS_MODEL_REVISION=

# Step 17: official NPS park notices. Put the real key only in ignored .env.local; keep this template blank.
# Without a key, notices show not configured; weather, RAG guidance and mock tests still work.
NPS_API_KEY=

# Step 18: enable either read-only travel MCP provider. The planner needs parks and at least one provider.
FLIGHTS_ENABLED=
HOTELS_ENABLED=
