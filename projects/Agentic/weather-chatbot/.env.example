# Copy this file to .env.local (in this same folder) and put your Gemini API key after GOOGLE_API_KEY=.
# Make the key in Google AI Studio or the Google Cloud console: APIs & Services > Credentials.
# .env.local is in .gitignore: it never goes into git. This example file does, so it must never hold a real key.
# Left empty, the chat answers that it isn't set up yet. On Vercel, set the same names in the project's settings
# (Settings > Environment Variables) instead, then redeploy: a deployment keeps the settings it was built with.
GOOGLE_API_KEY=

# Optional: an Apify API token, for REST · with auth; left empty, that lane is switched off. Make it in an Apify account
# used only for this bot (Apify Console: Settings > API & Integrations), since the token opens the whole account.
APIFY_TOKEN=

# Optional: another Gemini model. Left empty, the chat uses gemini-3.5-flash-lite, like the repo's other projects.
CHAT_MODEL=

# Optional: how much to log: fatal, error, warn, info, debug, trace or silent. Left empty, it's info.
LOG_LEVEL=

# Optional, step 9: Axiom gets the log lines when both are set: an API token that can only ingest into the dataset.
AXIOM_TOKEN=
AXIOM_DATASET=

# Optional, step 9: Sentry gets the errors with SENTRY_DSN; the build uploads source maps with the other three.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
