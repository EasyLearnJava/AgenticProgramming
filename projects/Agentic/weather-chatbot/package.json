{
  "name": "weather-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nimbus, a weather chatbot on Vercel that reaches the weather through four lanes: REST or MCP, with or without auth.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "evals": "vitest run --config vitest.evals.config.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.107",
    "@ai-sdk/mcp": "2.0.86",
    "@ai-sdk/react": "4.0.160",
    "@modelcontextprotocol/server": "2.4.0",
    "@sentry/nextjs": "11.8.0",
    "@vercel/functions": "3.10.4",
    "ai": "7.0.156",
    "botid": "1.5.12",
    "mcp-handler": "2.3.0",
    "next": "16.4.3",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
