# Copy this file to .env (in this same folder) and put your Gemini API key after the =.
# Make the key in the Google Cloud console: APIs & Services > Credentials.
# .env is in .gitignore: it never goes into git. This example file does, so it must never hold a real key.
GOOGLE_API_KEY=your-key-here

# Only for a Qdrant server that has an API key (kb_settings.toml's [vectorstore] location an https URL); never a
# setting in kb_settings.toml.
QDRANT_API_KEY=
