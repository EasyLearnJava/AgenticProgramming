# Copy this file to .env (in this same folder) and put your Gemini API key after the =.
# Make the key as tutorials/09-gemini-key's README shows: Google Cloud console > APIs & Services > Credentials.
# .env is in .gitignore: it never goes into git. This example file does, so it must never hold a real key.
GOOGLE_API_KEY=your-key-here

# Where the Qdrant server answers. docker-compose.yml starts one on this machine at this address.
QDRANT_URL=http://localhost:6333
